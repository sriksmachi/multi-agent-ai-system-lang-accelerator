# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Cosmos DB Configuration
AZURE_COSMOSDB_ENDPOINT=your-cosmosdb-endpoint
AZURE_COSMOSDB_KEY=your-cosmosdb-key
AZURE_COSMOSDB_DATABASE_NAME=your-database-name
AZURE_COSMOSDB_CONTAINER_NAME=your-container-name

# Azure AI Search Configuration
AZURE_SEARCH_ENDPOINT=your-search-endpoint
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=documents-index

# Agent Service URLs (for local development outside Docker)
# When using Docker Compose, these are set automatically via internal network
PLANNER_SERVICE_URL=http://localhost:8001
RESEARCHER_SERVICE_URL=http://localhost:8002
WRITER_SERVICE_URL=http://localhost:8003
REVIEWER_SERVICE_URL=http://localhost:8004

# Agent Ports
PLANNER_PORT=8001
RESEARCHER_PORT=8002
WRITER_PORT=8003
REVIEWER_PORT=8004
ORCHESTRATOR_PORT=8000

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: Azure Cosmos DB Emulator (for local development)
# AZURE_COSMOSDB_ENDPOINT=https://localhost:8081
# AZURE_COSMOSDB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Optional: Tracing Configuration
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string